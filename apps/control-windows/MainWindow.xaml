<Window x:Class="SkySpy.Control.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkySpy Control"
        Width="1180" Height="760" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FA"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111827">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="22,26,22,18">
                    <Border Width="42" Height="42" CornerRadius="12" Background="#2563EB" HorizontalAlignment="Left">
                        <TextBlock Text="S" Foreground="White" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="SKYSPY" Foreground="White" FontSize="19" FontWeight="Bold" Margin="0,16,0,2"/>
                    <TextBlock Text="DEVICE CONTROL" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="14,12,14,0">
                    <Border Background="#1E293B" CornerRadius="9" Padding="13,11" Margin="0,0,0,8">
                        <TextBlock Text="▦    Device overview" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="WORKSPACE" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="13,22,0,9"/>
                    <TextBlock Text="●    Connection status" Foreground="#CBD5E1" FontSize="12" Margin="13,0,0,14"/>
                    <TextBlock Text="◇    Diagnostics" Foreground="#CBD5E1" FontSize="12" Margin="13,0,0,14"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="20,18,20,22">
                    <Border Height="1" Background="#334155" Margin="0,0,0,15"/>
                    <TextBlock Text="SKYSPY LAN" Foreground="#CBD5E1" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="Personal device diagnostics" Foreground="#64748B" FontSize="10" Margin="0,4,0,0"/>
                    <TextBlock Text="Version 0.3.0" Foreground="#64748B" FontSize="10" Margin="0,12,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28,24,28,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="112"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Device overview" FontSize="23" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Monitor owner-approved device diagnostics on your local network."
                               FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#E8F7EF" CornerRadius="16" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ServiceDot" Width="8" Height="8" Fill="#16A34A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ServiceStateText" Text="Starting local service…" Foreground="#166534"
                                   FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,10,0,14">
                <Border Background="White" CornerRadius="12" Padding="17,13" Margin="0,0,10,0" BorderBrush="#E7EBF2" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="REGISTERED DEVICES" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="TotalCountText" Text="0" FontSize="27" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="17,13" Margin="0,0,10,0" BorderBrush="#E7EBF2" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="ONLINE" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="OnlineCountText" Text="0" FontSize="27" FontWeight="Bold" Foreground="#16A34A" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="17,13" Margin="0,0,10,0" BorderBrush="#E7EBF2" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="OFFLINE" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="OfflineCountText" Text="0" FontSize="27" FontWeight="Bold" Foreground="#64748B" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="17,13" BorderBrush="#E7EBF2" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="REFRESH INTERVAL" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="6 sec" FontSize="27" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="2" Background="White" CornerRadius="14" BorderBrush="#E7EBF2" BorderThickness="1" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="70"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Connected devices" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Only diagnostics approved by the device owner are displayed."
                                       FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Content="Refresh" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="#2563EB" Foreground="White" Click="Refresh_Click"/>
                    </Grid>

                    <DataGrid x:Name="DeviceGrid" Grid.Row="1" ItemsSource="{Binding Devices}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0" BorderThickness="0" Background="White"
                              HorizontalGridLinesBrush="#EEF1F5" VerticalGridLinesBrush="#FFFFFF"
                              RowHeight="48" ColumnHeaderHeight="36" FontSize="12">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DEVICE" Binding="{Binding Name}" Width="1.5*"/>
                            <DataGridTextColumn Header="MODEL" Binding="{Binding Model}" Width="1.5*"/>
                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="0.8*"/>
                            <DataGridTextColumn Header="BATTERY" Binding="{Binding Battery}" Width="0.8*"/>
                            <DataGridTextColumn Header="ANDROID" Binding="{Binding Android}" Width="1*"/>
                            <DataGridTextColumn Header="LAST SEEN" Binding="{Binding LastSeen}" Width="1.4*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Companion connection address" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock x:Name="LanAddressText" Text="Detecting local IPv4…" FontSize="12"
                                       FontWeight="SemiBold" Foreground="#0F172A" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Copy address" VerticalAlignment="Center"
                                Click="CopyAddress_Click" Background="#EAF0FA"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="3">
                <TextBlock x:Name="StatusText" Text="Starting SkySpy…" Foreground="#64748B" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock Text="Owner-approved diagnostics only" Foreground="#94A3B8" FontSize="10"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Window>